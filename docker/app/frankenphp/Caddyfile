{
	auto_https off

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

:80 {
	log {
		# Redact the authorization query parameter that can be set by Mercure
		format filter {
			wrap console

			fields {
				request>uri>query>authorization replace REDACTED
				request>headers>X-API-TOKEN replace REDACTED
			}
		}
	}

	handle /.well-known/* {
		mercure {
			# Modern (Mercure 1.x / OAuth 2.0) token validation.
			# The tokens issued by the app carry this exact "iss" value and the
			# canonical audience below as their "aud" claim.
			issuer {$PUBLIC_URL:https://partyhall.example.com} {
				publisher {
					jwt {env.MERCURE_PUBLISHER_JWT_KEY} {env.MERCURE_PUBLISHER_JWT_ALG}
				}
				subscriber {
					jwt {env.MERCURE_SUBSCRIBER_JWT_KEY} {env.MERCURE_SUBSCRIBER_JWT_ALG}
				}
			}
			resource_identifier {$PUBLIC_URL:https://partyhall.example.com}/.well-known/mercure
			# The frontend stores the subscriber JWT in this cookie.
			cookie_name mercureAuthorization
			{$MERCURE_EXTRA_DIRECTIVES}
		}
	}

	# I have caddy so much
	# let me use mercure on nginx!!!!
	handle /api/* {
		root * /app/public
		encode zstd br gzip
		php_server
	}

	handle /song_file/* {
		root * /app/public
		encode zstd br gzip
		php_server
	}

	handle /_profiler* {
		root * /app/public
		encode zstd br gzip
		php_server
	}

	handle /song_covers* {
		root * /app/public
		encode zstd br gzip
		file_server
	}

	handle /backdrops* {
		root * /app/public
		encode zstd br gzip
		file_server
	}

	handle /bundles/* {
		root * /app/public
		encode zstd br gzip
		file_server
	}

	handle {
		root * /frontend
		encode zstd br gzip
		try_files {path} /index.html
		file_server
	}

	vulcain

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Disable Topics tracking if not enabled explicitly: https://github.com/jkarlin/topics
	header ?Permissions-Policy "browsing-topics=()"
}
