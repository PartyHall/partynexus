{
    "name": "partyhall/partynexus",
    "type": "project",
    "license": "MIT",
    "description": "A sync server and homeplace for PartyHall appliances",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-redis": "*",
        "ext-xsl": "*",
        "ext-zip": "*",
        "api-platform/core": "^4.1",
        "doctrine/dbal": "^4.4.3",
        "doctrine/doctrine-bundle": "^3.2.4",
        "doctrine/doctrine-migrations-bundle": "^4.0.0",
        "doctrine/orm": "^3.2",
        "fakerphp/faker": "^1.23",
        "gesdinet/jwt-refresh-token-bundle": "^2.0.0",
        "hidehalo/nanoid-php": "^2.0",
        "intervention/image-symfony": "^1.2",
        "lcobucci/jwt": "^5.5",
        "lexik/jwt-authentication-bundle": "^3.1",
        "meilisearch/search-bundle": "^0.16",
        "nelmio/cors-bundle": "^2.5",
        "phpdocumentor/reflection-docblock": "^5.4",
        "phpstan/phpdoc-parser": "^1.30",
        "sentry/sentry-symfony": "^5.2",
        "symfony/asset": "^8.1",
        "symfony/console": "^8.1",
        "symfony/doctrine-messenger": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/expression-language": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/lock": "^8.1",
        "symfony/mailer": "^8.1",
        "symfony/mercure-bundle": "^0.4.2",
        "symfony/messenger": "^8.1",
        "symfony/monolog-bundle": "^4.0.2",
        "symfony/property-access": "^8.1",
        "symfony/property-info": "^8.1",
        "symfony/rate-limiter": "^8.1",
        "symfony/redis-messenger": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/serializer": "^8.1",
        "symfony/translation": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/uid": "^8.1",
        "symfony/validator": "^8.1",
        "symfony/yaml": "^8.1",
        "twig/extra-bundle": "^3.20",
        "twig/inky-extra": "^3.20",
        "vich/uploader-bundle": "^2.8"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^8.1",
            "docker": true
        }
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.3",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1",
        "symfony/debug-bundle": "^8.1",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/stopwatch": "^8.1",
        "symfony/web-profiler-bundle": "^8.1",
        "ticketswap/phpstan-error-formatter": "^1.3",
        "zenstruck/foundry": "^2.10.1"
    }
}
